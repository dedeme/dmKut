/// Page showing selected entry.

import "KtWeb/rp";
import "db";
import "cts";
import "data/entry";

/// \{*.} -> s
process = \Rq -> {
  switch (Rq.rq) {
    "idata": {
      gr = Rq.group;
      db.sync(gr);
      return rp.mk({
        Entries: db.read(gr),
        index: db.readIndexes()[gr],
        dbKey: db.readKey()
      });
    }
    "setIndex": {
      dbKey = db.checkKey(Rq.dbKey);
      if (dbKey == "") return rp.mkOutdated();

      group, index : Rq;
      ixV = [math.ftoi(index)];
      :arr Entries = db.read(group);
      if (!Entries) sys.throw("Entries is empty");
      ix = ixV! < 0
        ? Entries.size() - 1
        : ixV! >= Entries.size()
          ? 0
          : ixV!
      ;

      Ixs = db.readIndexes();
      Ixs[group] = ix;
      db.writeIndexes(Ixs);

      return rp.mkEmpty();
    }
    "setTranscription": {
      dbKey = db.checkKey(Rq.dbKey);
      if (dbKey == "") return rp.mkOutdated();

      group, index, text : Rq;
      ix = math.ftoi(index);
      :arr Entries = db.read(group);
      if (ix < Entries.size()) {
        Entries.sort(\:entry e1, :entry e2 -> return e1.id < e2.id;);
        :entry e = Entries[ix];
        Entries[ix] = entry.new(e.id, text);
        db.write(group, Entries);
      }

      return rp.mkEmpty();
    }
    default: sys.throw("Value of rq (" + Rq.rq + ") is not valid");
  }
};
