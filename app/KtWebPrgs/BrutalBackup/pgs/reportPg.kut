/// Report page.

import "KtWeb/rp";
import "data/fromServer";
import "data/fromClient";
import "db/fromServerTb";
import "db/fromClientTb";

/// \{*.} -> s
process = \Rq -> {
  switch (Rq.rq) {
    "idata": {
      return rp.mk({
          cl: fromClientTb.read()
        });
    }
    "update": {
      procs, ok = sys.cmd("ps", ["x"]);
      if (!ok) {
        sys.throw("Command 'ps x' failed");
      } else {
        :arr Procs = str.splitTrim(procs, "\n");
        if (!Procs.any(\l ->
          return str.index(l, "prgs/BrutalBackup/kut/main start") != -1;
        )) {
          fromServerTb.write(fromServer.newDefault());
        }
      }

      return rp.mk({
          sv: fromServerTb.read()
        });
    }
    "stop": {
      :fromClient cl = fromClientTb.read();
      cl.setAction(fromClient.stop);
      fromClientTb.write(cl);
      return rp.mkEmpty();
    }
    default: sys.throw("Value of rq (" + Rq.rq + ") is not valid");
  }
};
