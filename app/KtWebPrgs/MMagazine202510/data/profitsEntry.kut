/// Profits data of all the investors.

/// Creates a profits entry.
///   date   : Date in format YYYYMMDD
///   profits: Market + fixed incomes profits.
///   fi     : Fixed incomes profits.
///   \s,f,f -> <profitsEntry>
new : date, profits, fi;
