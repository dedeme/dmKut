/// Ipc module.

import "pgs/ipc/ipcPg";

/// \{*.} -> s
process = \Rq -> {
  switch (Rq.source) {
    "IpcPg": return ipcPg.process(Rq);
    default: sys.throw("Value of source (" + Rq.source + ") is not valid");
  }
};
