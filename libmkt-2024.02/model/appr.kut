/// Approximations model.

import "../model";
import "../cts";
import "doc/apprDoc";

/// Returns a new 'appr' model.
/// \-><model>
new = \ -> return model.new(
    "APRX",
    "Aproximaciones sucesivas",
    apprDoc.text,
    ["Inicio", "Aprox."],
    [model.percParam, model.percParam]
  );;

/// Caculates references.
/// \[[f.]], [f.] -> [f.]
refs = \:arr Closes, :arr Params -> {
  start = Params[0];
  upStart = 1.0 + start;
  downStart = 1.0 - start;
  incr = Params[1];
  :arr Cls0 = Closes[0];
  ndates = Closes.size();
  ncos = Cls0.size();

  IsSolds = arr.new(false, ncos);
  Refs = []; //[f.]
  for (cl = Cls0) Refs.push(cl * downStart);

  Refs2 = Refs.copy();
  AllRefs = arr.new(Refs2, ndates);
  for (idate = 1:ndates) {
    :arr ClosesR = Closes[idate];

    for (ico = 0:ncos) {
      c = ClosesR[ico];
      rf = Refs[ico];

      if (IsSolds.get(ico)) {
        if (c > rf) {
          IsSolds.set(ico, false);
          Refs[ico] = c * downStart;
        } else {
          Refs[ico] = rf - (rf - c) * incr;
        }
      } else {
        if (c < rf) {
          IsSolds.set(ico, true);
          Refs[ico] =  c * upStart;
        } else {
          Refs[ico] = rf + (c - rf) * incr;
        }
      }
    }
    AllRefs.set(idate, Refs.copy());
  }
  return AllRefs;
};
